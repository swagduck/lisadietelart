# MongoDB Atlas connection string (free tier M0 cluster compatible)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/art_portfolio?retryWrites=true&w=majority

# Cloudinary configuration for artwork image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Administrative access for managing artworks and orders
ADMIN_PASSWORD=pick-something-long

# Secret key for encrypting sessions and tokens (run: openssl rand -base64 32)
SESSION_SECRET=run_openssl_rand_base64_32

# Optional: Public site URL for metadata and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
